{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "schedule": ["before 6am on monday"],
  "timezone": "UTC",
  "rangeStrategy": "bump",
  "packageRules": [
    {
      "groupName": "all dependencies",
      "matchPackageNames": ["*"]
    }
  ],
  "vulnerabilityAlerts": {
    "labels": ["security"]
  }
}
