{
  "ci": {
    "collect": {
      "startServerCommand": "node src/server.js",
      "startServerReadyPattern": "Server listening",
      "url": [
        "http://localhost:3000/",
        "http://localhost:3000/services",
        "http://localhost:3000/blog",
        "http://localhost:3000/contact"
      ],
      "numberOfRuns": 1,
      "settings": {
        "preset": "mobile"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 0.95 }],
        "resource-summary:document:size": ["error", { "maxNumericValue": 65536 }],
        "resource-summary:script:size": ["error", { "maxNumericValue": 32768 }],
        "resource-summary:stylesheet:size": ["error", { "maxNumericValue": 65536 }],
        "resource-summary:image:size": ["error", { "maxNumericValue": 262144 }],
        "resource-summary:font:size": ["error", { "maxNumericValue": 86016 }]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
